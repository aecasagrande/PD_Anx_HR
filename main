OUTLIER_THRESHOLD = 0.30
MEDIAN_WINDOW = 11
MIN_RR_MS = 280
MAX_RR_MS = 2000
MORPHOLOGY_CORRELATION_THRESHOLD = 0.75
DETECTION_METHOD = 'kubios'
KUBIOS_ALPHA = 8.0
KUBIOS_WINDOW_BEATS = 91
KUBIOS_MEDFILT = 11
KUBIOS_C1 = 0.13
KUBIOS_C2 = 0.17
KUBIOS_MRRS_THRESH = 4.5
KUBIOS_TH_FLOOR_MS = 35.0
KUBIOS_TH_CEIL_FRAC = 0.20
PREMATURE_MIN_FRAC = 0.10
PREMATURE_GRID_TOL = 0.10
RR_REL_MIN_FRAC = 0.60
RHYTHM_HALF_WINDOW = 15
